# ─── Supabase (existing) ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from Supabase dashboard → Settings → API>

# ─── Automation (new) ────────────────────────────────────────────────────────

# Random secret for server-to-server calls — never commit the real value
# Generate: openssl rand -hex 32
AUTOMATION_SECRET=<random-hex-secret>

# ALSO add AUTOMATION_SECRET to Supabase Edge Function secrets:
#   https://supabase.com/dashboard/project/<ref>/functions/claude-proxy/secrets

# Supabase service role key (bypasses RLS — keep private)
# From: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Your Supabase user ID (the UUID of your account)
# From: Supabase dashboard → Authentication → Users → your email row → ID column
SUPABASE_USER_ID=<your-user-uuid>

# ─── Google Gmail API ─────────────────────────────────────────────────────────
# Setup: run `npm run setup:google-auth` after adding these two
# From: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# Obtained by running: npm run setup:google-auth
GOOGLE_REFRESH_TOKEN=<refresh-token>

# ─── Script tuning (optional) ────────────────────────────────────────────────
# DAILY_TOP_N=5           Max jobs to fully process (default 5)
# DAILY_MIN_SCORE=55      Min fit score to process (default 55)
# DAILY_MAX_ANALYZE=20    Max jobs to run fit analysis on (default 20)
# DAILY_LOOKBACK_DAYS=14  Days back to check for duplicates (default 14)
