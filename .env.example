# Copy to .env.local and fill in your Supabase project details
# From: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional, local dev only: shows a quick sign-in button on the login page
# when you type "applymaster" as the email
# VITE_DEV_TEST_EMAIL=
# VITE_DEV_TEST_PASSWORD=

# The Anthropic API key is NOT set here. It is a Supabase Edge Function secret:
#   npx supabase secrets set ANTHROPIC_API_KEY=your-api-key
